<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>{{title}} — Enfermeria Unipoli</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --ink: #0D1B2A;
      --ink2: #1a2e42;
      --muted: #7A7870;
      --muted2: #9E9B95;
      --border: #EDECEA;
      --bg: #F7F6F2;
      --white: #ffffff;
      --green: #00C6A0;
      --green2: #00A38A;
      --serif: 'DM Serif Display', serif;
      --sans: 'DM Sans', sans-serif;
      --r: 14px;
      --rlg: 20px;
    }
    html { scroll-behavior: smooth; }
    body { font-family: var(--sans); background: var(--bg); color: var(--ink); line-height: 1.6; min-height: 100vh; }
    h1,h2,h3 { font-weight: 600; }
    a { text-decoration: none; color: inherit; }
    img { max-width: 100%; }
    .container { max-width: 1100px; margin: 0 auto; padding: 0 2rem; }

    /* NAVBAR */
    .nav {
      background: var(--ink);
      position: sticky; top: 0; z-index: 1000;
      border-bottom: 1px solid rgba(255,255,255,0.06);
    }
    .nav-inner {
      display: flex; align-items: center;
      justify-content: space-between;
      height: 64px;
      max-width: 1100px; margin: 0 auto; padding: 0 2rem;
    }
    .nav-logo {
      display: flex; align-items: center; gap: .5rem;
      font-family: var(--serif); font-size: 1.3rem; color: white;
    }
    .nav-logo-icon {
      width: 32px; height: 32px; background: var(--green);
      border-radius: 8px; display: grid; place-items: center;
      font-size: .9rem; font-weight: 700; color: white;
      font-family: var(--sans);
    }
    .nav-links { display: flex; align-items: center; gap: 2rem; }
    .nav-links a { color: rgba(255,255,255,0.55); font-size: .88rem; font-weight: 400; transition: color .2s; }
    .nav-links a:hover { color: white; }
    .nav-right { display: flex; align-items: center; gap: .8rem; }
    .nav-avatar {
      width: 32px; height: 32px; border-radius: 50%;
      background: var(--green); color: white;
      display: grid; place-items: center;
      font-size: .8rem; font-weight: 600;
    }
    .nav-username { color: rgba(255,255,255,0.8); font-size: .88rem; }
    .nav-btn-out {
      padding: 6px 14px; border-radius: 8px;
      background: rgba(255,255,255,0.08);
      border: 1px solid rgba(255,255,255,0.12);
      color: rgba(255,255,255,0.6);
      font-size: .82rem; cursor: pointer;
      transition: all .2s; font-family: var(--sans);
    }
    .nav-btn-out:hover { background: rgba(255,255,255,0.14); color: white; }
    .nav-btn-login { color: rgba(255,255,255,0.65) !important; font-size: .88rem !important; }
    .nav-btn-reg {
      padding: 7px 18px; border-radius: 8px;
      background: var(--green); color: white !important;
      font-size: .85rem !important; font-weight: 500 !important;
      transition: background .2s;
    }
    .nav-btn-reg:hover { background: var(--green2); }

    /* FLASH */
    .flash { padding: 12px 2rem; text-align: center; font-size: .9rem; font-weight: 500; }
    .flash-success { background: #d1fae5; color: #065f46; }
    .flash-error { background: #fee2e2; color: #991b1b; }

    /* FOOTER */
    .footer { background: var(--ink); color: rgba(255,255,255,0.45); margin-top: 5rem; }
    .footer-inner {
      display: grid; grid-template-columns: 1.5fr 1fr 1fr;
      gap: 3rem; padding: 3.5rem 0 3rem;
      max-width: 1100px; margin: 0 auto; padding: 3.5rem 2rem 3rem;
    }
    .footer-brand-name { font-family: var(--serif); font-size: 1.2rem; color: white; margin-bottom: .5rem; display: flex; align-items: center; gap: .5rem; }
    .footer-brand p { font-size: .85rem; line-height: 1.7; max-width: 260px; }
    .footer-col h4 { color: rgba(255,255,255,0.3); font-size: .7rem; font-weight: 500; letter-spacing: .1em; text-transform: uppercase; margin-bottom: 1rem; }
    .footer-col a { display: block; color: rgba(255,255,255,0.5); font-size: .88rem; margin-bottom: .5rem; transition: color .2s; }
    .footer-col a:hover { color: white; }
    .footer-bottom { border-top: 1px solid rgba(255,255,255,0.07); padding: 1.2rem 2rem; max-width: 1100px; margin: 0 auto; font-size: .8rem; }
    @media(max-width:768px){
      .footer-inner { grid-template-columns: 1fr; gap: 2rem; }
      .nav-links { display: none; }
    }
  </style>
</head>
<body>

<!-- NAVBAR -->
<nav class="nav">
  <div class="nav-inner">
    <a href="/" class="nav-logo">
      <div class="nav-logo-icon">+</div>
      Enfermeria Unipoli
    </a>
    <div class="nav-links">
      <a href="/doctors/search">Buscar medicos</a>
      {{#if user}}
        <a href="/medicinas">Medicinas</a>
        {{#ifCond user.role '===' 'doctor'}}
          <a href="/doctors/panel/dashboard">Mi Panel</a>
          <a href="/recetas/nueva">📋 Emitir Receta</a>
        {{/ifCond}}
        {{#ifCond user.role '===' 'patient'}}
          <a href="/appointments/my">Mis Citas</a>
          <a href="/recetas/mis-recetas"> Mis Recetas</a>
        {{/ifCond}}
        {{#ifCond user.role '===' 'admin'}}
          <a href="/admin/doctors">Panel Admin</a>
        {{/ifCond}}
      {{/if}}
    </div>
    <div class="nav-right">
      {{#if user}}
        <div class="nav-avatar">{{firstLetter user.name}}</div>
        <span class="nav-username">{{user.name}}</span>
        <form action="/auth/logout" method="GET" style="margin:0;">
          <button type="submit" class="nav-btn-out">Salir</button>
        </form>
      {{else}}
        <a href="/auth/login" class="nav-links nav-btn-login">Iniciar sesión</a>
        <a href="/auth/register" class="nav-links nav-btn-reg">Registrarse</a>
      {{/if}}
    </div>
  </div>
</nav>

{{#if flash.success}}<div class="flash flash-success">{{flash.success}}</div>{{/if}}
{{#if flash.error}}<div class="flash flash-error">{{flash.error}}</div>{{/if}}

{{{body}}}

<!-- FOOTER -->
<footer class="footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <div class="footer-brand-name">
        <div class="nav-logo-icon">+</div>
        Enfermeria Unipoli
      </div>
      <p>La plataforma que conecta pacientes con los mejores especialistas médicos de México.</p>
    </div>
    <div class="footer-col">
      <h4>Pacientes</h4>
      <a href="/doctors/search">Buscar médicos</a>
      <a href="/appointments/my">Mis citas</a>
      <a href="/auth/register">Registrarse</a>
    </div>
    <div class="footer-col">
      <h4>Especialidades</h4>
      <a href="/doctors/search?specialty=Cardiolog%C3%ADa">Cardiología</a>
      <a href="/doctors/search?specialty=Dermatolog%C3%ADa">Dermatología</a>
      <a href="/doctors/search?specialty=Pediatr%C3%ADa">Pediatría</a>
      <a href="/doctors/search">Ver todas →</a>
    </div>
  </div>
  <div class="footer-bottom">© 2026 Enfermeria Unipoli. Todos los derechos reservados.</div>
</footer>

</body>
</html>
