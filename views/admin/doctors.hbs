<style>
.ad-hero { background: var(--ink); padding: 2.5rem 0 5rem; position: relative; overflow: hidden; }
.ad-hero-wave { position: absolute; bottom: -1px; left: 0; right: 0; height: 50px; background: var(--bg); clip-path: ellipse(55% 100% at 50% 100%); }
.ad-hero-inner { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; }
.ad-hero-title { font-family: var(--serif); font-size: 2rem; color: white; margin-bottom: .3rem; }
.ad-hero-sub { color: rgba(255,255,255,0.4); font-size: .88rem; }
.ad-btn-new { padding: 10px 22px; background: var(--green); color: white; border-radius: 10px; font-size: .88rem; font-weight: 500; transition: background .2s; border: none; cursor: pointer; font-family: var(--sans); }
.ad-btn-new:hover { background: var(--green2); }
.ad-wrap { max-width: 1100px; margin: -2rem auto 4rem; padding: 0 2rem; position: relative; }
.ad-stats { display: grid; grid-template-columns: repeat(3,1fr); gap: 1rem; margin-bottom: 1.5rem; }
.ad-stat { background: white; border: 1px solid var(--border); border-radius: 16px; padding: 1.3rem 1.6rem; display: flex; align-items: center; gap: 1rem; }
.ad-stat-icon { width: 44px; height: 44px; border-radius: 12px; background: var(--bg); display: grid; place-items: center; font-size: 1.2rem; }
.ad-stat-val { font-family: var(--serif); font-size: 1.8rem; line-height: 1; }
.ad-stat-label { font-size: .78rem; color: var(--muted2); margin-top: .1rem; }
.ad-card { background: white; border: 1px solid var(--border); border-radius: 20px; overflow: hidden; }
.ad-table-head { display: grid; grid-template-columns: 50px 1fr 140px 120px 100px 130px; gap: 1rem; padding: 1rem 1.5rem; background: var(--bg); border-bottom: 1px solid var(--border); font-size: .72rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--muted2); }
.ad-doctor-row { display: grid; grid-template-columns: 50px 1fr 140px 120px 100px 130px; gap: 1rem; padding: 1rem 1.5rem; border-bottom: 1px solid var(--border); align-items: center; transition: background .15s; }
.ad-doctor-row:last-child { border: none; }
.ad-doctor-row:hover { background: #FAFAF8; }
.ad-doc-av { width: 40px; height: 40px; border-radius: 10px; overflow: hidden; background: var(--bg); display: grid; place-items: center; }
.ad-doc-av img { width:100%;height:100%;object-fit:cover; }
.ad-doc-av-ph { font-family: var(--serif); font-size: 1.1rem; color: rgba(13,27,42,0.2); }
.ad-doc-name { font-weight: 600; font-size: .9rem; }
.ad-doc-email { font-size: .76rem; color: var(--muted2); }
.ad-doc-spec { font-size: .8rem; font-weight: 500; color: var(--green2); }
.ad-doc-city { font-size: .82rem; color: var(--muted); }
.ad-doc-fee { font-family: var(--serif); font-size: .95rem; }
.ad-row-btns { display: flex; gap: .4rem; }
.ad-btn-edit { padding: 5px 12px; border: 1.5px solid var(--border); border-radius: 8px; background: white; color: var(--ink); font-size: .78rem; font-weight: 500; cursor: pointer; transition: all .18s; font-family: var(--sans); }
.ad-btn-edit:hover { border-color: var(--ink); }
.ad-btn-del { padding: 5px 10px; border: 1.5px solid #FECACA; border-radius: 8px; background: white; color: #DC2626; font-size: .78rem; cursor: pointer; font-family: var(--sans); }
.ad-btn-del:hover { background: #FEF2F2; }
.ad-overlay { position: fixed; inset: 0; background: rgba(13,27,42,0.65); z-index: 2000; display: none; align-items: flex-start; justify-content: center; overflow-y: auto; padding: 2rem; backdrop-filter: blur(4px); }
.ad-overlay.open { display: flex; }
.ad-modal { background: white; border-radius: 20px; width: 100%; max-width: 780px; margin: auto; }
.ad-modal-head { background: var(--ink); padding: 1.5rem 2rem; display: flex; align-items: center; justify-content: space-between; border-radius: 20px 20px 0 0; }
.ad-modal-title { font-family: var(--serif); font-size: 1.3rem; color: white; }
.ad-modal-close { background: rgba(255,255,255,0.1); border: none; color: white; width: 32px; height: 32px; border-radius: 8px; cursor: pointer; font-size: 1rem; display: grid; place-items: center; }
.ad-modal-close:hover { background: rgba(255,255,255,0.2); }
.ad-modal-body { padding: 2rem; max-height: 70vh; overflow-y: auto; }
.ad-form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
.ad-form-full { grid-column: 1/-1; }
.ad-field { display: flex; flex-direction: column; gap: .4rem; }
.ad-flabel { font-size: .72rem; font-weight: 600; letter-spacing: .07em; text-transform: uppercase; color: var(--muted2); }
.ad-finput { padding: 11px 14px; border: 1.5px solid var(--border); border-radius: 12px; font-size: .9rem; font-family: var(--sans); color: var(--ink); background: #FAFAF8; outline: none; transition: border-color .2s; width: 100%; }
.ad-finput:focus { border-color: var(--ink); background: white; }
select.ad-finput { cursor: pointer; }
textarea.ad-finput { resize: vertical; min-height: 80px; }
.ad-map-wrap { height: 220px; border-radius: 12px; overflow: hidden; border: 1.5px solid var(--border); margin-top: .5rem; }
.ad-geo-btn { display: inline-flex; align-items: center; gap: .5rem; padding: 8px 14px; border: 1.5px solid var(--border); border-radius: 10px; background: #FAFAF8; color: var(--muted); font-size: .8rem; font-weight: 500; cursor: pointer; font-family: var(--sans); transition: all .2s; margin-top: .5rem; }
.ad-geo-btn:hover { border-color: var(--ink); color: var(--ink); }
.ad-sec { font-size: .68rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--muted2); margin: 1.4rem 0 .8rem; display: flex; align-items: center; gap: .5rem; }
.ad-sec::after { content:''; flex:1; height:1px; background: var(--border); }
.ad-sched { display: grid; grid-template-columns: repeat(7,1fr); gap: 6px; }
.ad-sday { background: var(--bg); border-radius: 10px; padding: 10px 6px; text-align: center; }
.ad-sday-n { font-size: .63rem; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; color: var(--muted2); margin-bottom: 8px; }
.ad-stin { width: 100%; padding: 5px 2px; border: 1.5px solid var(--border); border-radius: 7px; font-size: .68rem; font-family: var(--sans); color: var(--ink); background: white; outline: none; text-align: center; margin-bottom: 3px; }
.ad-stin:focus { border-color: var(--ink); }
.ad-ssep { font-size: .6rem; color: var(--muted2); margin: 2px 0; }
.ad-modal-foot { padding: 1.2rem 2rem; border-top: 1px solid var(--border); display: flex; gap: .8rem; justify-content: flex-end; }
.ad-btn-cancel2 { padding: 10px 22px; border: 1.5px solid var(--border); border-radius: 10px; background: white; color: var(--muted); font-size: .88rem; cursor: pointer; font-family: var(--sans); }
.ad-btn-save { padding: 10px 28px; background: var(--ink); color: white; border: none; border-radius: 10px; font-size: .88rem; font-weight: 500; cursor: pointer; font-family: var(--sans); transition: all .2s; }
.ad-btn-save:hover { background: var(--ink2); }
.ad-btn-save:disabled { opacity:.5; cursor:not-allowed; }
</style>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>

<div class="ad-hero">
  <div class="ad-hero-wave"></div>
  <div class="container ad-hero-inner">
    <div>
      <div class="ad-hero-title">Gestión de médicos</div>
      <div class="ad-hero-sub">Administra el directorio de especialistas</div>
    </div>
    <button class="ad-btn-new" onclick="openModal()">+ Agregar médico</button>
  </div>
</div>

<div class="ad-wrap">
  <div class="ad-stats">
    <div class="ad-stat"><div class="ad-stat-icon">👨‍⚕️</div><div><div class="ad-stat-val">{{doctors.length}}</div><div class="ad-stat-label">Médicos registrados</div></div></div>
    <div class="ad-stat"><div class="ad-stat-icon">✅</div><div><div class="ad-stat-val">{{activeCount}}</div><div class="ad-stat-label">Activos</div></div></div>
    <div class="ad-stat"><div class="ad-stat-icon">🩺</div><div><div class="ad-stat-val">{{specialtyCount}}</div><div class="ad-stat-label">Especialidades</div></div></div>
  </div>

  <div class="ad-card">
    <div class="ad-table-head"><div></div><div>Médico</div><div>Especialidad</div><div>Ciudad</div><div>Tarifa</div><div>Acciones</div></div>
    {{#each doctors}}
    <div class="ad-doctor-row">
      <div class="ad-doc-av">{{#if photo}}<img src="{{photo}}"/>{{else}}<div class="ad-doc-av-ph">{{firstLetter name}}</div>{{/if}}</div>
      <div><div class="ad-doc-name">{{name}}</div><div class="ad-doc-email">{{email}}</div></div>
      <div class="ad-doc-spec">{{specialty}}</div>
      <div class="ad-doc-city">{{location.city}}</div>
      <div class="ad-doc-fee">${{consultationFee}}</div>
      <div class="ad-row-btns">
        <button class="ad-btn-edit" onclick="editDoctor('{{id}}')">Editar</button>
        <button class="ad-btn-del" onclick="delDoctor('{{id}}','{{name}}')">✕</button>
      </div>
    </div>
    {{/each}}
  </div>
</div>

<!-- MODAL -->
<div class="ad-overlay" id="modal">
  <div class="ad-modal">
    <div class="ad-modal-head">
      <div class="ad-modal-title" id="mTitle">Agregar médico</div>
      <button class="ad-modal-close" onclick="closeModal()">✕</button>
    </div>
    <div class="ad-modal-body">
      <div class="ad-sec">Información básica</div>
      <div class="ad-form-grid">
        <div class="ad-field"><label class="ad-flabel">Nombre completo</label><input class="ad-finput" id="f-name" type="text" placeholder="Dr. Nombre Apellido"/></div>
        <div class="ad-field"><label class="ad-flabel">Correo electrónico</label><input class="ad-finput" id="f-email" type="email" placeholder="doctor@email.com"/></div>
        <div class="ad-field"><label class="ad-flabel">Especialidad</label><select class="ad-finput" id="f-spec">{{#each specialties}}<option value="{{this}}">{{this}}</option>{{/each}}</select></div>
        <div class="ad-field"><label class="ad-flabel">WhatsApp</label><input class="ad-finput" id="f-phone" type="tel" placeholder="+521234567890"/></div>
        <div class="ad-field"><label class="ad-flabel">Tarifa (MXN)</label><input class="ad-finput" id="f-fee" type="number" placeholder="500"/></div>
        <div class="ad-field"><label class="ad-flabel">Años experiencia</label><input class="ad-finput" id="f-exp" type="number" placeholder="5"/></div>
        <div class="ad-field ad-form-full"><label class="ad-flabel">Biografía</label><textarea class="ad-finput" id="f-bio" rows="3" placeholder="Descripción del médico..."></textarea></div>
        <div class="ad-field ad-form-full"><label class="ad-flabel">URL de foto</label><input class="ad-finput" id="f-photo" type="url" placeholder="https://..."/></div>
      </div>

      <div class="ad-sec">Ubicación del consultorio</div>
      <div class="ad-form-grid">
        <div class="ad-field ad-form-full">
          <label class="ad-flabel">Dirección</label>
          <input class="ad-finput" id="f-addr" type="text" placeholder="Calle, número, colonia"/>
          <button type="button" class="ad-geo-btn" onclick="geocode()">📍 Ubicar en mapa</button>
        </div>
        <div class="ad-field"><label class="ad-flabel">Ciudad</label><input class="ad-finput" id="f-city" type="text"/></div>
        <div class="ad-field"><label class="ad-flabel">Estado</label><input class="ad-finput" id="f-state" type="text"/></div>
        <div class="ad-field"><label class="ad-flabel">Latitud</label><input class="ad-finput" id="f-lat" type="number" step="0.000001"/></div>
        <div class="ad-field"><label class="ad-flabel">Longitud</label><input class="ad-finput" id="f-lng" type="number" step="0.000001"/></div>
      </div>
      <div class="ad-map-wrap" id="mMap"></div>

      <div class="ad-sec">Horario de atención</div>
      <div class="ad-sched">
        <div class="ad-sday"><div class="ad-sday-n">Lun</div><input class="ad-stin" type="time" id="s-monday-s"/><div class="ad-ssep">↓</div><input class="ad-stin" type="time" id="s-monday-e"/></div>
        <div class="ad-sday"><div class="ad-sday-n">Mar</div><input class="ad-stin" type="time" id="s-tuesday-s"/><div class="ad-ssep">↓</div><input class="ad-stin" type="time" id="s-tuesday-e"/></div>
        <div class="ad-sday"><div class="ad-sday-n">Mié</div><input class="ad-stin" type="time" id="s-wednesday-s"/><div class="ad-ssep">↓</div><input class="ad-stin" type="time" id="s-wednesday-e"/></div>
        <div class="ad-sday"><div class="ad-sday-n">Jue</div><input class="ad-stin" type="time" id="s-thursday-s"/><div class="ad-ssep">↓</div><input class="ad-stin" type="time" id="s-thursday-e"/></div>
        <div class="ad-sday"><div class="ad-sday-n">Vie</div><input class="ad-stin" type="time" id="s-friday-s"/><div class="ad-ssep">↓</div><input class="ad-stin" type="time" id="s-friday-e"/></div>
        <div class="ad-sday"><div class="ad-sday-n">Sáb</div><input class="ad-stin" type="time" id="s-saturday-s"/><div class="ad-ssep">↓</div><input class="ad-stin" type="time" id="s-saturday-e"/></div>
        <div class="ad-sday"><div class="ad-sday-n">Dom</div><input class="ad-stin" type="time" id="s-sunday-s"/><div class="ad-ssep">↓</div><input class="ad-stin" type="time" id="s-sunday-e"/></div>
      </div>
    </div>
    <div class="ad-modal-foot">
      <button class="ad-btn-cancel2" onclick="closeModal()">Cancelar</button>
      <button class="ad-btn-save" id="saveBtn" onclick="saveDoctor()">Guardar médico</button>
    </div>
  </div>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
let mMap=null, mMarker=null, editId=null;
const DAYS=['monday','tuesday','wednesday','thursday','friday','saturday','sunday'];

function mkIcon(){ return L.divIcon({ html:'<div style="width:36px;height:36px;background:#0D1B2A;border-radius:50%;display:grid;place-items:center;color:white;font-size:1rem;border:3px solid white;box-shadow:0 4px 12px rgba(0,0,0,.3);">+</div>', className:'', iconSize:[36,36], iconAnchor:[18,18] }); }

function initMap(lat=19.4271,lng=-99.1677){
  if(mMap){mMap.remove();mMap=null;}
  mMap=L.map('mMap').setView([lat,lng],14);
  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{attribution:'© OpenStreetMap'}).addTo(mMap);
  mMarker=L.marker([lat,lng],{icon:mkIcon(),draggable:true}).addTo(mMap);
  mMarker.on('dragend',e=>{ const p=e.target.getLatLng(); setCoords(p.lat,p.lng); });
  mMap.on('click',e=>{ mMarker.setLatLng(e.latlng); setCoords(e.latlng.lat,e.latlng.lng); });
}

function setCoords(lat,lng){
  document.getElementById('f-lat').value=lat.toFixed(6);
  document.getElementById('f-lng').value=lng.toFixed(6);
}

function openModal(){ editId=null; document.getElementById('mTitle').textContent='Agregar médico'; document.getElementById('saveBtn').textContent='Guardar médico'; clearForm(); document.getElementById('modal').classList.add('open'); setTimeout(()=>initMap(),250); }
function closeModal(){ document.getElementById('modal').classList.remove('open'); if(mMap){mMap.remove();mMap=null;} }

function clearForm(){
  ['name','email','phone','fee','exp','bio','photo','addr','city','state','lat','lng'].forEach(f=>{ const e=document.getElementById('f-'+f); if(e) e.value=''; });
  DAYS.forEach(d=>{ document.getElementById('s-'+d+'-s').value=''; document.getElementById('s-'+d+'-e').value=''; });
}

async function geocode(){
  const addr=document.getElementById('f-addr').value;
  if(!addr) return alert('Ingresa una dirección');
  try{
    const r=await fetch('https://api.geoapify.com/v1/geocode/search?text='+encodeURIComponent(addr)+'&apiKey={{geoapifyKey}}');
    const d=await r.json();
    if(d.features?.length){
      const [lng,lat]=d.features[0].geometry.coordinates;
      setCoords(lat,lng);
      mMap.setView([lat,lng],15);
      mMarker.setLatLng([lat,lng]);
    } else alert('No se encontró la dirección');
  } catch(e){ alert('Error al buscar'); }
}

function getSchedule(){
  const s={};
  DAYS.forEach(d=>{
    const st=document.getElementById('s-'+d+'-s').value;
    const en=document.getElementById('s-'+d+'-e').value;
    s[d]=(st&&en)?[{start:st,end:en}]:[];
  });
  return s;
}

async function saveDoctor(){
  const name=document.getElementById('f-name').value.trim();
  if(!name) return alert('El nombre es requerido');
  const btn=document.getElementById('saveBtn');
  btn.disabled=true; btn.textContent='Guardando...';
  const data={
    name, email:document.getElementById('f-email').value,
    specialty:document.getElementById('f-spec').value,
    phone:document.getElementById('f-phone').value,
    consultationFee:Number(document.getElementById('f-fee').value)||0,
    experience:Number(document.getElementById('f-exp').value)||0,
    bio:document.getElementById('f-bio').value,
    photo:document.getElementById('f-photo').value,
    location:{
      address:document.getElementById('f-addr').value,
      city:document.getElementById('f-city').value,
      state:document.getElementById('f-state').value,
      lat:Number(document.getElementById('f-lat').value)||0,
      lng:Number(document.getElementById('f-lng').value)||0,
    },
    schedule:getSchedule(), slotDuration:30, isActive:true, verified:false, rating:0, reviewCount:0,
  };
  try{
    const url=editId?'/admin/doctors/'+editId:'/admin/doctors';
    const r=await fetch(url,{method:editId?'PUT':'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});
    const res=await r.json();
    if(res.success){closeModal();location.reload();}
    else{alert(res.error||'Error al guardar');btn.disabled=false;btn.textContent='Guardar médico';}
  }catch(e){alert('Error');btn.disabled=false;btn.textContent='Guardar médico';}
}

async function editDoctor(id){
  try{
    const r=await fetch('/admin/doctors/'+id);
    const d=await r.json();
    if(!d.doctor) return alert('Error');
    const doc=d.doctor;
    editId=id;
    document.getElementById('mTitle').textContent='Editar médico';
    document.getElementById('saveBtn').textContent='Guardar cambios';
    document.getElementById('f-name').value=doc.name||'';
    document.getElementById('f-email').value=doc.email||'';
    document.getElementById('f-spec').value=doc.specialty||'';
    document.getElementById('f-phone').value=doc.phone||'';
    document.getElementById('f-fee').value=doc.consultationFee||'';
    document.getElementById('f-exp').value=doc.experience||'';
    document.getElementById('f-bio').value=doc.bio||'';
    document.getElementById('f-photo').value=doc.photo||'';
    document.getElementById('f-addr').value=doc.location?.address||'';
    document.getElementById('f-city').value=doc.location?.city||'';
    document.getElementById('f-state').value=doc.location?.state||'';
    document.getElementById('f-lat').value=doc.location?.lat||'';
    document.getElementById('f-lng').value=doc.location?.lng||'';
    DAYS.forEach(d=>{ const b=doc.schedule?.[d]||[]; document.getElementById('s-'+d+'-s').value=b[0]?.start||''; document.getElementById('s-'+d+'-e').value=b[0]?.end||''; });
    document.getElementById('modal').classList.add('open');
    setTimeout(()=>initMap(doc.location?.lat||19.4271,doc.location?.lng||(-99.1677)),250);
  }catch(e){alert('Error al cargar');}
}

async function delDoctor(id,name){
  if(!confirm('¿Eliminar a '+name+'? No se puede deshacer.')) return;
  const r=await fetch('/admin/doctors/'+id,{method:'DELETE'});
  const d=await r.json();
  if(d.success) location.reload(); else alert('Error al eliminar');
}

document.getElementById('modal').addEventListener('click',e=>{ if(e.target===document.getElementById('modal')) closeModal(); });
</script>
