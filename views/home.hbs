<style>
/* HERO */
.h-hero {
  background: var(--ink);
  padding: 5rem 0 8rem;
  position: relative;
  overflow: hidden;
}
.h-hero-noise {
  position: absolute; inset: 0;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
  pointer-events: none;
}
.h-hero-glow {
  position: absolute;
  width: 600px; height: 600px;
  background: radial-gradient(circle, rgba(0,198,160,0.1) 0%, transparent 65%);
  top: -150px; right: -100px; pointer-events: none;
}
.h-hero-glow2 {
  position: absolute;
  width: 400px; height: 400px;
  background: radial-gradient(circle, rgba(0,100,200,0.07) 0%, transparent 70%);
  bottom: -100px; left: -50px; pointer-events: none;
}
.h-hero-wave {
  position: absolute; bottom: -1px; left: 0; right: 0;
  height: 80px;
  background: var(--bg);
  clip-path: ellipse(55% 100% at 50% 100%);
}
.h-hero-inner {
  display: grid;
  grid-template-columns: 1fr .85fr;
  gap: 4rem;
  align-items: center;
  position: relative;
}
.h-hero-tag {
  display: inline-flex; align-items: center; gap: .5rem;
  background: rgba(0,198,160,0.12);
  border: 1px solid rgba(0,198,160,0.25);
  color: var(--green);
  padding: 5px 14px; border-radius: 50px;
  font-size: .78rem; font-weight: 500; letter-spacing: .06em;
  text-transform: uppercase; margin-bottom: 1.4rem;
}
.h-hero-tag-dot { width: 6px; height: 6px; background: var(--green); border-radius: 50%; }
.h-hero-title {
  font-family: var(--serif);
  font-size: clamp(2.4rem, 4.5vw, 3.6rem);
  line-height: 1.1;
  color: white;
  margin-bottom: 1.2rem;
}
.h-hero-title em { font-style: italic; color: var(--green); }
.h-hero-sub { color: rgba(255,255,255,0.5); font-size: 1rem; margin-bottom: 2.5rem; line-height: 1.7; max-width: 420px; }

/* SEARCH BOX */
.h-search {
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 16px;
  padding: .5rem;
  display: flex;
  gap: .4rem;
  flex-wrap: wrap;
  backdrop-filter: blur(8px);
}
.h-search-group {
  display: flex; align-items: center; gap: .5rem;
  flex: 1; min-width: 140px; padding: .5rem .8rem;
}
.h-search-group:not(:last-child) {
  border-right: 1px solid rgba(255,255,255,0.1);
}
.h-search-icon { color: rgba(255,255,255,0.3); font-size: .9rem; }
.h-search input {
  border: none; outline: none; background: transparent;
  font-size: .9rem; color: white; width: 100%;
  font-family: var(--sans);
}
.h-search input::placeholder { color: rgba(255,255,255,0.3); }
.h-search-btn {
  padding: 11px 24px;
  background: var(--green); color: white;
  border: none; border-radius: 12px;
  font-size: .9rem; font-weight: 500;
  cursor: pointer; white-space: nowrap;
  font-family: var(--sans);
  transition: background .2s;
}
.h-search-btn:hover { background: var(--green2); }

/* STATS CARD */
.h-stats-card {
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 24px;
  padding: 2.5rem;
  backdrop-filter: blur(8px);
}
.h-stat { margin-bottom: 2rem; }
.h-stat:last-child { margin: 0; }
.h-stat-val {
  font-family: var(--serif);
  font-size: 2.8rem;
  color: white;
  line-height: 1;
  margin-bottom: .2rem;
}
.h-stat-val span { color: var(--green); }
.h-stat-label { color: rgba(255,255,255,0.35); font-size: .85rem; }
.h-stat-bar {
  height: 3px; background: rgba(255,255,255,0.07);
  border-radius: 2px; margin-top: .8rem;
  overflow: hidden;
}
.h-stat-bar-fill {
  height: 100%; border-radius: 2px;
  background: linear-gradient(90deg, var(--green), transparent);
}

/* SPECIALTIES */
.h-spec { padding: 5rem 0; }
.h-sec-header { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 2.5rem; }
.h-sec-label { font-size: .7rem; letter-spacing: .12em; text-transform: uppercase; color: var(--muted2); margin-bottom: .4rem; font-weight: 500; }
.h-sec-title { font-family: var(--serif); font-size: 2rem; color: var(--ink); }
.h-link-all { color: var(--muted); font-size: .88rem; border-bottom: 1px solid var(--border); padding-bottom: 2px; transition: color .2s; white-space: nowrap; }
.h-link-all:hover { color: var(--ink); }

.h-spec-grid { display: grid; grid-template-columns: repeat(8,1fr); gap: 10px; }
.h-spec-card {
  background: white; border: 1px solid var(--border);
  border-radius: 14px; padding: 1.2rem .5rem;
  text-align: center; cursor: pointer;
  transition: all .2s; display: flex;
  flex-direction: column; align-items: center; gap: .5rem;
  color: var(--muted);
}
.h-spec-card:hover { border-color: var(--ink); color: var(--ink); transform: translateY(-2px); box-shadow: 0 6px 20px rgba(0,0,0,0.07); }
.h-spec-icon { font-size: 1.6rem; }
.h-spec-name { font-size: .75rem; font-weight: 500; line-height: 1.3; }

/* DOCTORS */
.h-docs { padding: 0 0 5rem; }
.h-docs-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 1.2rem; }
.h-doc-card {
  background: white; border: 1px solid var(--border);
  border-radius: 20px; overflow: hidden;
  transition: all .25s; display: block; color: var(--ink);
}
.h-doc-card:hover { box-shadow: 0 12px 40px rgba(0,0,0,0.08); transform: translateY(-3px); }
.h-doc-photo { height: 180px; background: var(--bg); overflow: hidden; position: relative; }
.h-doc-photo img { width: 100%; height: 100%; object-fit: cover; }
.h-doc-photo-ph {
  width: 100%; height: 100%;
  display: grid; place-items: center;
  font-family: var(--serif); font-size: 3.5rem;
  color: rgba(13,27,42,0.15);
}
.h-doc-body { padding: 1.4rem; }
.h-doc-spec { font-size: .72rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--green2); margin-bottom: .4rem; }
.h-doc-name { font-family: var(--serif); font-size: 1.15rem; margin-bottom: .3rem; }
.h-doc-city { font-size: .82rem; color: var(--muted2); margin-bottom: .8rem; }
.h-doc-foot { display: flex; align-items: center; justify-content: space-between; }
.h-doc-rating { font-size: .85rem; color: var(--muted); }
.h-doc-rating strong { color: var(--ink); }
.h-doc-btn {
  padding: 7px 16px; background: var(--ink); color: white;
  border-radius: 8px; font-size: .8rem; font-weight: 500;
}

/* HOW */
.h-how { background: var(--ink); padding: 5rem 0; }
.h-how-title { font-family: var(--serif); font-size: 2.2rem; color: white; text-align: center; margin-bottom: .5rem; }
.h-how-sub { text-align: center; color: rgba(255,255,255,0.35); font-size: .9rem; margin-bottom: 3.5rem; }
.h-steps { display: grid; grid-template-columns: repeat(3,1fr); gap: 1.5rem; }
.h-step {
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 20px; padding: 2rem;
}
.h-step-num {
  font-family: var(--serif); font-size: 3rem;
  color: rgba(0,198,160,0.2); line-height: 1; margin-bottom: 1.2rem;
}
.h-step h3 { color: white; font-size: 1rem; margin-bottom: .6rem; }
.h-step p { color: rgba(255,255,255,0.4); font-size: .88rem; line-height: 1.7; }

@media(max-width:900px){
  .h-hero-inner { grid-template-columns: 1fr; }
  .h-stats-card { display: none; }
  .h-spec-grid { grid-template-columns: repeat(4,1fr); }
  .h-docs-grid { grid-template-columns: repeat(2,1fr); }
  .h-steps { grid-template-columns: 1fr; }
}
@media(max-width:600px){
  .h-docs-grid { grid-template-columns: 1fr; }
}
</style>

<!-- HERO -->
<section class="h-hero">
  <div class="h-hero-noise"></div>
  <div class="h-hero-glow"></div>
  <div class="h-hero-glow2"></div>
  <div class="h-hero-wave"></div>
  <div class="container h-hero-inner">
    <div>
      <div class="h-hero-tag"><div class="h-hero-tag-dot"></div> Plataforma médica verificada</div>
      <h1 class="h-hero-title">Tu salud merece al <em>mejor</em> especialista</h1>
      <p class="h-hero-sub">Encuentra médicos verificados, revisa sus horarios y agenda tu cita en minutos — con confirmación por WhatsApp.</p>
      <form class="h-search" action="/doctors/search" method="GET">
        <div class="h-search-group">
          <span class="h-search-icon">🔍</span>
          <input type="text" name="name" placeholder="Especialidad o médico..."/>
        </div>
        <div class="h-search-group">
          <span class="h-search-icon">📍</span>
          <input type="text" name="city" placeholder="Ciudad..."/>
        </div>
        <button type="submit" class="h-search-btn">Buscar</button>
      </form>
    </div>
    <div class="h-stats-card">
      <div class="h-stat">
        <div class="h-stat-val">+<span>500</span></div>
        <div class="h-stat-label">Médicos verificados activos</div>
        <div class="h-stat-bar"><div class="h-stat-bar-fill" style="width:85%"></div></div>
      </div>
      <div class="h-stat">
        <div class="h-stat-val"><span>12k</span>+</div>
        <div class="h-stat-label">Citas realizadas este año</div>
        <div class="h-stat-bar"><div class="h-stat-bar-fill" style="width:70%"></div></div>
      </div>
      <div class="h-stat">
        <div class="h-stat-val">⭐ <span>4.8</span></div>
        <div class="h-stat-label">Calificación promedio</div>
        <div class="h-stat-bar"><div class="h-stat-bar-fill" style="width:96%"></div></div>
      </div>
    </div>
  </div>
</section>

<!-- ESPECIALIDADES -->
<section class="h-spec">
  <div class="container">
    <div class="h-sec-header">
      <div>
        <div class="h-sec-label">Explora por área médica</div>
        <h2 class="h-sec-title">Especialidades</h2>
      </div>
      <a href="/doctors/search" class="h-link-all">Ver todas las especialidades →</a>
    </div>
    <div class="h-spec-grid">
      {{#each specialties}}
        <a href="/doctors/search?specialty={{encodeURI this}}" class="h-spec-card">
          <span class="h-spec-icon">🩺</span>
          <span class="h-spec-name">{{this}}</span>
        </a>
      {{/each}}
    </div>
  </div>
</section>

<!-- MÉDICOS DESTACADOS -->
{{#if featuredDoctors.length}}
<section class="h-docs">
  <div class="container">
    <div class="h-sec-header">
      <div>
        <div class="h-sec-label">Los más valorados</div>
        <h2 class="h-sec-title">Médicos destacados</h2>
      </div>
      <a href="/doctors/search" class="h-link-all">Ver todos →</a>
    </div>
    <div class="h-docs-grid">
      {{#each featuredDoctors}}
        <a href="/doctors/{{id}}" class="h-doc-card">
          <div class="h-doc-photo">
            {{#if photo}}
              <img src="{{photo}}" alt="{{name}}"/>
            {{else}}
              <div class="h-doc-photo-ph">{{firstLetter name}}</div>
            {{/if}}
          </div>
          <div class="h-doc-body">
            <div class="h-doc-spec">{{specialty}}</div>
            <div class="h-doc-name">{{name}}</div>
            <div class="h-doc-city">📍 {{location.city}}</div>
            <div class="h-doc-foot">
              <span class="h-doc-rating">⭐ <strong>{{rating}}</strong> ({{reviewCount}})</span>
              <span class="h-doc-btn">Ver perfil</span>
            </div>
          </div>
        </a>
      {{/each}}
    </div>
  </div>
</section>
{{/if}}

<!-- CÓMO FUNCIONA -->
<section class="h-how">
  <div class="container">
    <h2 class="h-how-title">¿Cómo funciona?</h2>
    <p class="h-how-sub">Tres pasos para tu próxima cita médica</p>
    <div class="h-steps">
      <div class="h-step">
        <div class="h-step-num">01</div>
        <h3>Busca tu especialista</h3>
        <p>Filtra por especialidad o ciudad. Lee reseñas verificadas de otros pacientes para elegir con confianza.</p>
      </div>
      <div class="h-step">
        <div class="h-step-num">02</div>
        <h3>Elige fecha y horario</h3>
        <p>Consulta la disponibilidad real del médico y selecciona el horario que mejor se adapte a tu agenda.</p>
      </div>
      <div class="h-step">
        <div class="h-step-num">03</div>
        <h3>Confirmación por WhatsApp</h3>
        <p>Recibe confirmación inmediata y un recordatorio 24 horas antes de tu cita directamente en WhatsApp.</p>
      </div>
    </div>
  </div>
</section>
