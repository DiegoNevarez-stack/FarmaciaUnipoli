{{#> layouts/main title=title}}

<style>
  .med-detail-hero{background:#0D1B2A;padding:3rem 0;margin-bottom:2.5rem;}
  .med-detail-hero h1{color:#fff;font-family:'DM Serif Display',serif;font-size:2rem;margin:0 0 .5rem;}
  .med-detail-hero .badges{display:flex;gap:.5rem;flex-wrap:wrap;}
  .badge{font-size:.8rem;font-weight:700;padding:.3rem .75rem;border-radius:20px;}
  .badge-pres{background:rgba(0,198,160,.2);color:#00C6A0;}
  .badge-receta{background:#FFF3E0;color:#F57C00;}
  .badge-libre{background:#E8F5E9;color:#388E3C;}
  .detail-grid{display:grid;grid-template-columns:1fr 320px;gap:2rem;}
  .detail-card{background:#fff;border:1px solid #EDECEA;border-radius:14px;padding:2rem;}
  .detail-card h3{font-family:'DM Serif Display',serif;font-size:1.2rem;color:#0D1B2A;margin:0 0 1rem;padding-bottom:.75rem;border-bottom:1px solid #f0f0f0;}
  .info-row{display:flex;justify-content:space-between;padding:.6rem 0;border-bottom:1px solid #f8f8f8;}
  .info-row:last-child{border-bottom:none;}
  .info-label{color:#888;font-size:.9rem;}
  .info-value{color:#0D1B2A;font-weight:600;font-size:.9rem;}
  .precio-big{font-size:2.5rem;font-weight:700;color:#0D1B2A;font-family:'DM Serif Display',serif;}
  .stock-pill{display:inline-block;padding:.3rem .75rem;border-radius:20px;font-size:.8rem;font-weight:700;}
  .stock-ok{background:#EFF9F7;color:#00C6A0;}
  .stock-bajo{background:#FFF3E0;color:#F57C00;}
  .stock-agotado{background:#FFEBEE;color:#e53e3e;}
  .btn-back{display:inline-flex;align-items:center;gap:.5rem;color:#888;text-decoration:none;font-size:.9rem;margin-bottom:1.5rem;}
  .btn-back:hover{color:#0D1B2A;}
  .admin-actions{display:flex;gap:.75rem;margin-top:1.5rem;}
  .btn-edit{background:#0D1B2A;color:#fff;padding:.6rem 1.25rem;border-radius:10px;text-decoration:none;font-weight:600;font-size:.9rem;}
  .btn-delete{background:#FFEBEE;color:#e53e3e;padding:.6rem 1.25rem;border-radius:10px;border:none;cursor:pointer;font-weight:600;font-size:.9rem;}
  @media(max-width:768px){.detail-grid{grid-template-columns:1fr;}}
</style>

<div class="med-detail-hero">
  <div class="container">
    <a href="/medicinas" class="btn-back" style="color:rgba(255,255,255,.6);">← Volver al catálogo</a>
    <h1>{{medicina.nombre}}</h1>
    <div class="badges">
      <span class="badge badge-pres">{{medicina.presentacion}}</span>
      {{#if medicina.receta}}
        <span class="badge badge-receta">🔴 Requiere receta médica</span>
      {{else}}
        <span class="badge badge-libre">🟢 Venta libre</span>
      {{/if}}
    </div>
  </div>
</div>

<div class="container" style="padding-bottom:3rem;">
  <div class="detail-grid">

    {{!-- Columna izquierda --}}
    <div>
      {{#if medicina.descripcion}}
      <div class="detail-card" style="margin-bottom:1.25rem;">
        <h3>📋 Descripción</h3>
        <p style="color:#555;line-height:1.7;margin:0;">{{medicina.descripcion}}</p>
      </div>
      {{/if}}

      {{#if medicina.dosis}}
      <div class="detail-card">
        <h3>💉 Dosificación</h3>
        <p style="color:#555;line-height:1.7;margin:0;">{{medicina.dosis}}</p>
      </div>
      {{/if}}

      {{#if user.role}}{{#ifCond user.role "===" "admin"}}
      <div class="admin-actions">
        <a href="/medicinas/{{medicina.id}}/editar" class="btn-edit">✏ Editar</a>
        <form method="POST" action="/medicinas/{{medicina.id}}?_method=DELETE" onsubmit="return confirm('¿Eliminar esta medicina?')">
          <button type="submit" class="btn-delete">🗑 Eliminar</button>
        </form>
      </div>
      {{/ifCond}}{{/if}}
    </div>

    {{!-- Columna derecha --}}
    <div>
      <div class="detail-card" style="margin-bottom:1.25rem;">
        <h3>💰 Precio</h3>
        <div class="precio-big">${{medicina.precio}}</div>
        <div style="margin-top:.75rem;">
          {{#ifCond medicina.stock "===" 0}}
            <span class="stock-pill stock-agotado">Sin stock</span>
          {{else}}
            {{#ifCond medicina.stock "<" 10}}
              <span class="stock-pill stock-bajo">⚠ Stock bajo: {{medicina.stock}} uds.</span>
            {{else}}
              <span class="stock-pill stock-ok">✓ En stock: {{medicina.stock}} uds.</span>
            {{/ifCond}}
          {{/ifCond}}
        </div>
      </div>

      <div class="detail-card">
        <h3>ℹ Información</h3>
        <div class="info-row">
          <span class="info-label">Laboratorio</span>
          <span class="info-value">{{#if medicina.laboratorio}}{{medicina.laboratorio}}{{else}}—{{/if}}</span>
        </div>
        <div class="info-row">
          <span class="info-label">Presentación</span>
          <span class="info-value">{{medicina.presentacion}}</span>
        </div>
        <div class="info-row">
          <span class="info-label">Receta</span>
          <span class="info-value">{{#if medicina.receta}}Sí, requerida{{else}}No requerida{{/if}}</span>
        </div>
      </div>
    </div>

  </div>
</div>

{{/layouts/main}}
