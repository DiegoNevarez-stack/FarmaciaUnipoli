{{!-- views/recetas/mis-recetas.hbs --}}
<style>
  .mr-hero { background: var(--ink); padding: 2.5rem 0 5rem; position: relative; overflow: hidden; }
  .mr-hero-wave { position: absolute; bottom: -1px; left: 0; right: 0; height: 50px; background: var(--bg); clip-path: ellipse(55% 100% at 50% 100%); }
  .mr-hero-title { font-family: var(--serif); font-size: 2rem; color: white; margin-bottom: .4rem; }
  .mr-hero-sub { color: rgba(255,255,255,.4); font-size: .9rem; }

  .mr-wrap { max-width: 860px; margin: -2rem auto 4rem; padding: 0 2rem; position: relative; }

  .mr-count { background: white; border: 1px solid var(--border); border-radius: 12px; padding: .7rem 1.2rem; margin-bottom: 1.2rem; font-size: .88rem; color: var(--ink2); }
  .mr-count strong { color: var(--ink); }

  .mr-card { background: white; border: 1px solid var(--border); border-radius: 18px; overflow: hidden; margin-bottom: 1rem; box-shadow: 0 2px 12px rgba(0,0,0,.04); }

  .mr-card-head { background: linear-gradient(135deg, var(--ink) 0%, var(--ink2) 100%); padding: 1rem 1.5rem; display: flex; justify-content: space-between; align-items: center; }
  .mr-folio { color: white; font-weight: 700; font-size: .95rem; font-family: var(--serif); }
  .mr-fecha { color: rgba(255,255,255,.55); font-size: .8rem; }

  .mr-card-body { padding: 1.4rem 1.5rem; }
  .mr-doctor { font-size: .82rem; color: var(--muted); margin-bottom: 1.1rem; }

  .mr-meds-label { font-size: .7rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); margin-bottom: .6rem; }

  .mr-med { border-left: 4px solid var(--green); background: var(--bg); border-radius: 0 10px 10px 0; padding: .8rem 1rem; margin-bottom: .6rem; }
  .mr-med:last-child { margin-bottom: 0; }
  .mr-med-nombre { font-weight: 700; font-size: .95rem; color: var(--ink); margin-bottom: .4rem; }
  .mr-pill { display: inline-block; font-size: .76rem; font-weight: 600; padding: 3px 10px; border-radius: 20px; background: #e8f5f2; color: #047857; margin-bottom: .4rem; }
  .mr-indic { font-size: .84rem; color: var(--ink2); line-height: 1.55; background: #fffbf0; border: 1px solid #fde68a; border-radius: 8px; padding: .55rem .85rem; margin-top: .4rem; }

  .mr-empty { text-align: center; padding: 4.5rem 2rem; background: white; border-radius: 18px; border: 1px solid var(--border); }
  .mr-empty-icon { font-size: 3rem; margin-bottom: 1rem; opacity: .4; }
  .mr-empty h3 { font-family: var(--serif); font-size: 1.4rem; margin-bottom: .4rem; }
  .mr-empty p { color: var(--muted2); font-size: .88rem; }
</style>

<div class="mr-hero">
  <div class="mr-hero-wave"></div>
  <div class="container">
    <div class="mr-hero-title">Mis Recetas</div>
    <div class="mr-hero-sub">Recetas asignadas a {{user.email}}</div>
  </div>
</div>

<div class="mr-wrap">
  {{#if recetas.length}}
    <div class="mr-count">📋 Tienes <strong>{{recetas.length}}</strong> receta(s) asignada(s)</div>

    {{#each recetas}}
      <div class="mr-card">
        <div class="mr-card-head">
          <span class="mr-folio">{{folio}}</span>
          <span class="mr-fecha">📅 {{fecha_emision}}</span>
        </div>
        <div class="mr-card-body">
          <div class="mr-doctor">👨‍⚕️ Dr(a). {{doctor_nombre}} &nbsp;·&nbsp; {{doctor_email}}</div>

          <div class="mr-meds-label">💊 Medicamentos ({{medicamentos.length}})</div>

          {{#each medicamentos}}
            <div class="mr-med">
              <div class="mr-med-nombre">{{nombre}}</div>
              {{#if dosis}}<span class="mr-pill">📏 {{dosis}}</span>{{/if}}
              {{#if indicaciones}}<div class="mr-indic">📝 {{indicaciones}}</div>{{/if}}
            </div>
          {{/each}}
        </div>
      </div>
    {{/each}}

  {{else}}
    <div class="mr-empty">
      <div class="mr-empty-icon">📋</div>
      <h3>Sin recetas asignadas</h3>
      <p>Cuando un médico te emita una receta, aparecerá aquí automáticamente.</p>
    </div>
  {{/if}}
</div>
