<style>
.s-hero { background: var(--ink); padding: 2.5rem 0 5rem; position: relative; overflow: hidden; }
.s-hero-wave { position: absolute; bottom: -1px; left: 0; right: 0; height: 50px; background: var(--bg); clip-path: ellipse(55% 100% at 50% 100%); }
.s-hero-title { font-family: var(--serif); font-size: 2rem; color: white; margin-bottom: .4rem; }
.s-hero-sub { color: rgba(255,255,255,0.4); font-size: .9rem; }

.s-wrap { max-width: 1100px; margin: -2rem auto 4rem; padding: 0 2rem; display: grid; grid-template-columns: 260px 1fr; gap: 1.5rem; position: relative; }

/* FILTERS */
.s-filters { background: white; border-radius: 18px; border: 1px solid var(--border); padding: 1.6rem; align-self: start; position: sticky; top: 80px; }
.s-filters-title { font-size: .7rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--muted2); margin-bottom: 1.4rem; }
.s-filter-group { margin-bottom: 1.2rem; }
.s-filter-label { font-size: .75rem; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--muted2); margin-bottom: .5rem; display: block; }
.s-filter-input {
  width: 100%; padding: 10px 12px;
  border: 1.5px solid var(--border); border-radius: 10px;
  font-size: .88rem; font-family: var(--sans); color: var(--ink);
  background: #FAFAF8; outline: none; transition: border-color .2s;
}
.s-filter-input:focus { border-color: var(--ink); background: white; }
.s-filter-btn {
  width: 100%; padding: 11px; background: var(--ink); color: white;
  border: none; border-radius: 10px; font-size: .88rem; font-weight: 500;
  font-family: var(--sans); cursor: pointer; margin-top: .4rem;
  transition: background .2s;
}
.s-filter-btn:hover { background: var(--ink2); }
.s-clear { display: block; text-align: center; color: var(--muted2); font-size: .8rem; margin-top: .7rem; transition: color .2s; }
.s-clear:hover { color: var(--ink); }

/* RESULTS */
.s-results-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.2rem; }
.s-count { font-family: var(--serif); font-size: 1.4rem; }
.s-count span { color: var(--muted2); font-family: var(--sans); font-size: .88rem; font-weight: 400; }

.s-doc-card {
  background: white; border: 1px solid var(--border);
  border-radius: 18px; padding: 1.5rem;
  display: grid; grid-template-columns: 100px 1fr;
  gap: 1.4rem; margin-bottom: 1rem;
  transition: all .22s; color: var(--ink);
  display: flex; align-items: center;
}
.s-doc-card:hover { box-shadow: 0 8px 32px rgba(0,0,0,0.08); transform: translateY(-2px); }
.s-doc-photo { width: 90px; height: 90px; border-radius: 14px; overflow: hidden; background: var(--bg); flex-shrink: 0; display: grid; place-items: center; }
.s-doc-photo img { width: 100%; height: 100%; object-fit: cover; }
.s-doc-photo-ph { font-family: var(--serif); font-size: 2.2rem; color: rgba(13,27,42,0.15); }
.s-doc-body { flex: 1; }
.s-doc-spec { font-size: .72rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--green2); margin-bottom: .3rem; }
.s-doc-name { font-family: var(--serif); font-size: 1.15rem; margin-bottom: .2rem; }
.s-doc-city { font-size: .82rem; color: var(--muted2); margin-bottom: .5rem; }
.s-doc-bio { font-size: .83rem; color: var(--muted); line-height: 1.5; margin-bottom: .8rem; }
.s-doc-foot { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: .5rem; }
.s-doc-rating { font-size: .85rem; color: var(--muted); }
.s-doc-rating strong { color: var(--ink); }
.s-doc-fee { font-family: var(--serif); font-size: 1.1rem; color: var(--ink); }
.s-doc-btn { padding: 7px 18px; background: var(--ink); color: white; border-radius: 8px; font-size: .8rem; font-weight: 500; }
.s-verified { display: inline-flex; align-items: center; gap: .3rem; background: #F0FAF8; color: var(--green2); border: 1px solid rgba(0,198,160,0.2); padding: 2px 8px; border-radius: 6px; font-size: .7rem; font-weight: 600; margin-left: .5rem; }

.s-empty { text-align: center; padding: 4rem 2rem; background: white; border-radius: 18px; border: 1px solid var(--border); }
.s-empty-icon { font-size: 3rem; margin-bottom: 1rem; }
.s-empty h3 { font-family: var(--serif); font-size: 1.3rem; margin-bottom: .4rem; }
.s-empty p { color: var(--muted2); font-size: .88rem; }

@media(max-width:800px){ .s-wrap { grid-template-columns: 1fr; } .s-filters { position: static; } }
</style>

<div class="s-hero">
  <div class="s-hero-wave"></div>
  <div class="container">
    <div class="s-hero-title">Buscar especialistas</div>
    <div class="s-hero-sub">Encuentra el médico ideal para ti</div>
  </div>
</div>

<div class="s-wrap">
  <!-- FILTROS -->
  <aside class="s-filters">
    <div class="s-filters-title">Filtros</div>
    <form action="/doctors/search" method="GET">
      <div class="s-filter-group">
        <label class="s-filter-label">Especialidad</label>
        <select name="specialty" class="s-filter-input" onchange="this.form.submit()">
          <option value="">Todas las especialidades</option>
          {{#each specialties}}
            <option value="{{this}}" {{#ifCond this '===' ../filters.specialty}}selected{{/ifCond}}>{{this}}</option>
          {{/each}}
        </select>
      </div>
      <div class="s-filter-group">
        <label class="s-filter-label">Ciudad</label>
        <input class="s-filter-input" type="text" name="city" value="{{filters.city}}" placeholder="Ej: Ciudad de México"/>
      </div>
      <div class="s-filter-group">
        <label class="s-filter-label">Nombre del médico</label>
        <input class="s-filter-input" type="text" name="name" value="{{filters.name}}" placeholder="Dr. ..."/>
      </div>
      <button type="submit" class="s-filter-btn">Buscar</button>
      <a href="/doctors/search" class="s-clear">Limpiar filtros</a>
    </form>
  </aside>

  <!-- RESULTADOS -->
  <div>
    <div class="s-results-header">
      <div class="s-count">{{doctorsCount}} médico{{#ifCond doctorsCount '!==' 1}}s{{/ifCond}} <span>encontrado{{#ifCond doctorsCount '!==' 1}}s{{/ifCond}}</span></div>
    </div>

    {{#if doctors.length}}
      {{#each doctors}}
        <a href="/doctors/{{id}}" class="s-doc-card">
          <div class="s-doc-photo">
            {{#if photo}}<img src="{{photo}}" alt="{{name}}"/>
            {{else}}<div class="s-doc-photo-ph">{{firstLetter name}}</div>{{/if}}
          </div>
          <div class="s-doc-body">
            <div class="s-doc-spec">{{specialty}}{{#if verified}}<span class="s-verified">✓ Verificado</span>{{/if}}</div>
            <div class="s-doc-name">{{name}}</div>
            <div class="s-doc-city">📍 {{location.city}}, {{location.state}}</div>
            {{#if bio}}<div class="s-doc-bio">{{truncate bio 90}}</div>{{/if}}
            <div class="s-doc-foot">
              <span class="s-doc-rating">⭐ <strong>{{rating}}</strong> · {{reviewCount}} reseñas</span>
              <span class="s-doc-fee">${{consultationFee}} MXN</span>
              <span class="s-doc-btn">Ver disponibilidad →</span>
            </div>
          </div>
        </a>
      {{/each}}
    {{else}}
      <div class="s-empty">
        <div class="s-empty-icon">🔍</div>
        <h3>Sin resultados</h3>
        <p>Intenta con otros filtros o una especialidad diferente</p>
      </div>
    {{/if}}
  </div>
</div>
