{{#> layouts/main title=title}}

<style>
  .med-hero{background:#0D1B2A;padding:3rem 0 2rem;margin-bottom:2rem;}
  .med-hero h1{color:#fff;font-family:'DM Serif Display',serif;font-size:2.2rem;margin:0 0 .5rem;}
  .med-hero p{color:rgba(255,255,255,.65);margin:0;}
  .med-filters{background:#fff;border:1px solid #EDECEA;border-radius:12px;padding:1.25rem 1.5rem;margin-bottom:1.5rem;display:flex;flex-wrap:wrap;gap:.75rem;align-items:flex-end;}
  .med-filters label{font-size:.8rem;font-weight:600;color:#666;display:block;margin-bottom:.25rem;}
  .med-filters input,.med-filters select{padding:.45rem .75rem;border:1px solid #ddd;border-radius:8px;font-size:.9rem;outline:none;}
  .med-filters input:focus,.med-filters select:focus{border-color:#00C6A0;}
  .med-filters .btn-buscar{background:#00C6A0;color:#fff;border:none;padding:.5rem 1.2rem;border-radius:8px;cursor:pointer;font-weight:600;}
  .med-filters .btn-limpiar{background:#f5f5f5;color:#333;border:1px solid #ddd;padding:.5rem 1rem;border-radius:8px;cursor:pointer;font-size:.85rem;text-decoration:none;}
  .med-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:1.25rem;}
  .med-card{background:#fff;border:1px solid #EDECEA;border-radius:12px;padding:1.25rem;transition:box-shadow .2s;}
  .med-card:hover{box-shadow:0 4px 20px rgba(0,0,0,.08);}
  .med-card-top{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:.75rem;}
  .med-badge{font-size:.7rem;font-weight:700;padding:.25rem .6rem;border-radius:20px;text-transform:capitalize;}
  .med-badge-pres{background:#EFF9F7;color:#00C6A0;}
  .med-badge-receta{background:#FFF3E0;color:#F57C00;font-size:.65rem;}
  .med-badge-libre{background:#E8F5E9;color:#388E3C;font-size:.65rem;}
  .med-nombre{font-family:'DM Serif Display',serif;font-size:1.15rem;font-weight:600;color:#0D1B2A;margin:0 0 .3rem;}
  .med-lab{font-size:.8rem;color:#888;margin:0 0 .5rem;}
  .med-desc{font-size:.85rem;color:#555;line-height:1.5;margin:0 0 .75rem;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;}
  .med-footer{display:flex;justify-content:space-between;align-items:center;padding-top:.75rem;border-top:1px solid #f0f0f0;}
  .med-precio{font-size:1.1rem;font-weight:700;color:#0D1B2A;}
  .med-stock{font-size:.8rem;color:#888;}
  .med-stock.bajo{color:#e53e3e;}
  .med-actions{display:flex;gap:.5rem;}
  .btn-ver{background:#0D1B2A;color:#fff;padding:.35rem .85rem;border-radius:8px;font-size:.8rem;text-decoration:none;font-weight:600;}
  .btn-editar{background:#f0f0f0;color:#333;padding:.35rem .85rem;border-radius:8px;font-size:.8rem;text-decoration:none;font-weight:600;}
  .med-empty{text-align:center;padding:4rem 2rem;color:#888;}
  .med-empty svg{width:60px;height:60px;opacity:.3;margin-bottom:1rem;}
  .alert-ok{background:#EFF9F7;border:1px solid #00C6A0;color:#00C6A0;padding:.75rem 1rem;border-radius:8px;margin-bottom:1rem;font-size:.9rem;}
</style>

<div class="med-hero">
  <div class="container">
    <h1>💊 Catálogo de Medicinas</h1>
    <p>Consulta disponibilidad, presentaciones y precios</p>
  </div>
</div>

<div class="container" style="padding-bottom:3rem;">

  {{#if filtros.buscar}}{{#if total}}
    <div class="alert-ok">✅ {{total}} resultado(s) para "{{filtros.buscar}}"</div>
  {{/if}}{{/if}}

  {{!-- Filtros --}}
  <form class="med-filters" method="GET" action="/medicinas">
    <div>
      <label>Buscar</label>
      <input type="text" name="buscar" value="{{filtros.buscar}}" placeholder="Nombre, laboratorio…" style="min-width:200px;">
    </div>
    <div>
      <label>Presentación</label>
      <select name="presentacion">
        <option value="">Todas</option>
        {{#each presentaciones}}
          <option value="{{this}}" {{#ifCond ../filtros.presentacion "===" this}}selected{{/ifCond}}>{{this}}</option>
        {{/each}}
      </select>
    </div>
    <div>
      <label>Requiere receta</label>
      <select name="receta">
        <option value="">Todas</option>
        <option value="true"  {{#ifCond filtros.receta "===" "true"}}selected{{/ifCond}}>Sí</option>
        <option value="false" {{#ifCond filtros.receta "===" "false"}}selected{{/ifCond}}>No</option>
      </select>
    </div>
    <div>
      <button type="submit" class="btn-buscar">🔍 Buscar</button>
    </div>
    <div>
      <a href="/medicinas" class="btn-limpiar">✖ Limpiar</a>
    </div>
    {{#if user.role}}{{#ifCond user.role "===" "admin"}}
    <div style="margin-left:auto;">
      <a href="/medicinas/nueva" style="background:#00C6A0;color:#fff;padding:.5rem 1.2rem;border-radius:8px;font-weight:700;text-decoration:none;font-size:.9rem;">+ Nueva Medicina</a>
    </div>
    {{/ifCond}}{{/if}}
  </form>

  {{!-- Grid --}}
  {{#if medicinas.length}}
    <p style="color:#888;font-size:.85rem;margin-bottom:1rem;">{{total}} medicinas encontradas</p>
    <div class="med-grid">
      {{#each medicinas}}
      <div class="med-card">
        <div class="med-card-top">
          <span class="med-badge med-badge-pres">{{presentacion}}</span>
          {{#if receta}}
            <span class="med-badge med-badge-receta">🔴 Requiere receta</span>
          {{else}}
            <span class="med-badge med-badge-libre">🟢 Venta libre</span>
          {{/if}}
        </div>
        <p class="med-nombre">{{nombre}}</p>
        <p class="med-lab">{{#if laboratorio}}{{laboratorio}}{{else}}&nbsp;{{/if}}</p>
        {{#if descripcion}}<p class="med-desc">{{descripcion}}</p>{{/if}}
        <div class="med-footer">
          <div>
            <div class="med-precio">${{precio}}</div>
            <div class="med-stock {{#ifCond stock "<" 10}}bajo{{/ifCond}}">Stock: {{stock}}</div>
          </div>
          <div class="med-actions">
            <a href="/medicinas/{{id}}" class="btn-ver">Ver</a>
            {{#if ../user.role}}{{#ifCond ../user.role "===" "admin"}}
            <a href="/medicinas/{{id}}/editar" class="btn-editar">✏</a>
            {{/ifCond}}{{/if}}
          </div>
        </div>
      </div>
      {{/each}}
    </div>
  {{else}}
    <div class="med-empty">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
      <p>No se encontraron medicinas con esos filtros.</p>
    </div>
  {{/if}}

</div>

{{/layouts/main}}
