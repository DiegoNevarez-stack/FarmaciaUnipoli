{{!-- views/recetas/ver.hbs --}}
<style>
  .rx-ver-wrap { max-width: 700px; margin: 2.5rem auto; padding: 0 2rem; }

  .rx-actions { display: flex; gap: .7rem; margin-bottom: 1.5rem; flex-wrap: wrap; }
  .rx-btn { padding: 8px 18px; border-radius: 10px; font-size: .85rem; font-weight: 500; cursor: pointer; font-family: var(--sans); border: 1.5px solid var(--border); background: white; color: var(--ink); transition: all .2s; text-decoration: none; display: inline-flex; align-items: center; gap: .4rem; }
  .rx-btn:hover { border-color: var(--ink); }
  .rx-btn-primary { background: var(--green); color: white; border-color: var(--green); }
  .rx-btn-primary:hover { background: var(--green2); border-color: var(--green2); color: white; }

  .rx-doc { background: white; border: 1px solid var(--border); border-radius: var(--rlg); overflow: hidden; box-shadow: 0 4px 24px rgba(0,0,0,.07); }

  .rx-doc-head { background: linear-gradient(135deg, var(--ink) 0%, var(--ink2) 100%); padding: 1.8rem 2rem; display: flex; justify-content: space-between; align-items: flex-start; }
  .rx-doc-brand { color: white; }
  .rx-doc-brand-name { font-family: var(--serif); font-size: 1.4rem; display: flex; align-items: center; gap: .5rem; margin-bottom: .2rem; }
  .rx-doc-brand-icon { width: 28px; height: 28px; background: var(--green); border-radius: 7px; display: grid; place-items: center; font-size: .85rem; font-weight: 700; color: white; }
  .rx-doc-brand-sub { font-size: .8rem; color: rgba(255,255,255,.55); }
  .rx-doc-meta { text-align: right; color: white; }
  .rx-doc-folio { font-size: 1.1rem; font-weight: 700; font-family: var(--serif); }
  .rx-doc-fecha { font-size: .8rem; color: rgba(255,255,255,.55); margin-top: .2rem; }

  .rx-doc-body { padding: 2rem; }

  .rx-partes { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem; }
  .rx-parte { padding: .9rem 1.1rem; border-radius: var(--r); }
  .rx-parte-doctor { background: #f0f4ff; }
  .rx-parte-paciente { background: #f0fff8; }
  .rx-parte-label { font-size: .7rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); margin-bottom: .35rem; }
  .rx-parte-nombre { font-weight: 700; font-size: .95rem; color: var(--ink); word-break: break-all; }
  .rx-parte-sub { font-size: .8rem; color: var(--muted); margin-top: .15rem; }

  .rx-seccion { margin-bottom: 1.4rem; }
  .rx-seccion-label { font-size: .7rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); margin-bottom: .7rem; }

  .rx-med { border-left: 4px solid var(--green); background: var(--bg); border-radius: 0 var(--r) var(--r) 0; padding: .9rem 1.1rem; margin-bottom: .7rem; }
  .rx-med:last-child { margin-bottom: 0; }
  .rx-med-nombre { font-weight: 700; font-size: 1rem; color: var(--ink); margin-bottom: .5rem; }
  .rx-pill-row { display: flex; gap: .5rem; flex-wrap: wrap; margin-bottom: .4rem; }
  .rx-pill { font-size: .78rem; font-weight: 600; padding: 4px 12px; border-radius: 20px; }
  .rx-pill-dosis { background: #e8f5f2; color: var(--green2); }
  .rx-med-indic { font-size: .85rem; color: var(--ink2); line-height: 1.6; background: #fffbf0; border: 1px solid #fde68a; border-radius: 8px; padding: .6rem .9rem; margin-top: .5rem; }

  .rx-firma { display: flex; justify-content: space-between; align-items: flex-end; border-top: 1px solid var(--border); padding-top: 1.5rem; margin-top: 1.5rem; flex-wrap: wrap; gap: 1rem; }
  .rx-firma-linea { text-align: center; }
  .rx-firma-raya { width: 180px; border-top: 1px solid #999; margin: 2.5rem auto .4rem; }
  .rx-firma-nombre { font-size: .82rem; font-weight: 600; color: var(--ink); }
  .rx-firma-cargo { font-size: .75rem; color: var(--muted); }
  .rx-firma-datos { text-align: right; font-size: .82rem; color: var(--muted); line-height: 1.8; }
  .rx-firma-datos strong { color: var(--ink); }
  .rx-valida { color: var(--green2); font-weight: 700; font-size: .85rem; margin-top: .3rem; }

  @media print {
    .rx-actions { display: none !important; }
    .nav, .footer { display: none !important; }
    .rx-doc { box-shadow: none; border: 1.5px solid #000; }
    body { background: white !important; }
  }
  @media(max-width:600px) {
    .rx-partes { grid-template-columns: 1fr; }
    .rx-doc-head { flex-direction: column; gap: .8rem; }
    .rx-doc-meta { text-align: left; }
    .rx-firma { flex-direction: column; align-items: flex-start; }
    .rx-firma-datos { text-align: left; }
  }
</style>

<div class="rx-ver-wrap">

  <div class="rx-actions no-print">
    <button onclick="window.print()" class="rx-btn rx-btn-primary">🖨️ Imprimir</button>
    <a href="/recetas/nueva" class="rx-btn">+ Nueva Receta</a>
    <a href="/doctors/panel/dashboard" class="rx-btn">← Dashboard</a>
  </div>

  <div class="rx-doc">
    <div class="rx-doc-head">
      <div class="rx-doc-brand">
        <div class="rx-doc-brand-name">
          <div class="rx-doc-brand-icon">+</div>
          Farmacia Unipoli
        </div>
        <div class="rx-doc-brand-sub">Receta Médica Electrónica</div>
      </div>
      <div class="rx-doc-meta">
        <div class="rx-doc-folio">{{receta.folio}}</div>
        <div class="rx-doc-fecha">{{receta.fecha}}</div>
      </div>
    </div>

    <div class="rx-doc-body">

      <div class="rx-partes">
        <div class="rx-parte rx-parte-doctor">
          <div class="rx-parte-label">Médico Tratante</div>
          <div class="rx-parte-nombre">Dr(a). {{receta.doctor.nombre}}</div>
          <div class="rx-parte-sub">{{receta.doctor.email}}</div>
        </div>
        <div class="rx-parte rx-parte-paciente">
          <div class="rx-parte-label">Paciente</div>
          <div class="rx-parte-nombre">{{receta.paciente.email}}</div>
        </div>
      </div>

      <div class="rx-seccion">
        <div class="rx-seccion-label">
          💊 Medicamentos Prescritos ({{receta.medicamentos.length}})
        </div>
        {{#each receta.medicamentos}}
          <div class="rx-med">
            <div class="rx-med-nombre">💊 {{medicamento}}</div>
            {{#if dosis}}
              <div class="rx-pill-row">
                <span class="rx-pill rx-pill-dosis">📏 {{dosis}}</span>
              </div>
            {{/if}}
            {{#if indicaciones}}
              <div class="rx-med-indic">📝 {{indicaciones}}</div>
            {{/if}}
          </div>
        {{/each}}
      </div>

      <div class="rx-firma">
        <div class="rx-firma-linea">
          <div class="rx-firma-raya"></div>
          <div class="rx-firma-nombre">Dr(a). {{receta.doctor.nombre}}</div>
          <div class="rx-firma-cargo">Firma del Médico</div>
        </div>
        <div class="rx-firma-datos">
          <div>Folio: <strong>{{receta.folio}}</strong></div>
          <div>Fecha: {{receta.fecha}}</div>
          <div class="rx-valida">✅ Receta válida</div>
        </div>
      </div>

    </div>
  </div>
</div>
