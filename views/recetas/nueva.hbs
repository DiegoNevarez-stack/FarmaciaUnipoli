{{!-- views/recetas/nueva.hbs --}}
<style>
  .rx-wrap { max-width: 720px; margin: 3rem auto; padding: 0 2rem; }

  .rx-page-header { display: flex; align-items: center; gap: 1rem; margin-bottom: 2rem; }
  .rx-page-icon { width: 48px; height: 48px; background: #e8f5f2; border-radius: 12px; display: grid; place-items: center; font-size: 1.4rem; flex-shrink: 0; }
  .rx-page-title { font-family: var(--serif); font-size: 1.6rem; color: var(--ink); }
  .rx-page-sub { font-size: .85rem; color: var(--muted); margin-top: .1rem; }

  .rx-card { background: var(--white); border: 1px solid var(--border); border-radius: var(--rlg); margin-bottom: 1.2rem; overflow: hidden; }
  .rx-card-head { padding: .9rem 1.4rem; background: var(--bg); border-bottom: 1px solid var(--border); font-weight: 600; font-size: .9rem; color: var(--ink); display: flex; justify-content: space-between; align-items: center; }
  .rx-card-body { padding: 1.4rem; }

  .rx-field { margin-bottom: 1rem; }
  .rx-field:last-child { margin-bottom: 0; }
  .rx-label { display: block; font-size: .82rem; font-weight: 600; color: var(--ink2); margin-bottom: .35rem; }
  .rx-input, .rx-select, .rx-textarea {
    width: 100%; padding: .6rem .9rem;
    border: 1.5px solid var(--border); border-radius: var(--r);
    font-family: var(--sans); font-size: .88rem; color: var(--ink);
    background: var(--white); transition: border-color .2s;
    outline: none; box-sizing: border-box;
  }
  .rx-input:focus, .rx-select:focus, .rx-textarea:focus { border-color: var(--green); }
  .rx-textarea { resize: vertical; min-height: 80px; }
  .rx-hint { font-size: .75rem; color: var(--muted2); margin-top: .25rem; }

  /* Fila de medicamento */
  .med-fila {
    background: #f9faf8; border: 1.5px solid var(--border);
    border-radius: var(--r); padding: 1rem; margin-bottom: .8rem;
    position: relative;
  }
  .med-fila-head {
    display: flex; justify-content: space-between; align-items: center;
    margin-bottom: .9rem;
  }
  .med-badge {
    background: var(--green); color: white; font-size: .75rem;
    font-weight: 600; padding: 3px 10px; border-radius: 20px;
  }
  .med-quitar {
    background: none; border: 1px solid #fca5a5; color: #dc2626;
    border-radius: 8px; padding: 3px 10px; font-size: .78rem;
    cursor: pointer; font-family: var(--sans); transition: all .2s;
  }
  .med-quitar:hover { background: #fee2e2; }

  .med-grid { display: grid; gap: .8rem; }
  .med-grid-top { grid-template-columns: 1fr 1fr; }
  .med-grid-bot { grid-template-columns: 1fr; }

  .btn-agregar {
    padding: 7px 16px; background: var(--ink); color: white;
    border: none; border-radius: 8px; font-size: .82rem;
    font-weight: 500; cursor: pointer; font-family: var(--sans);
    transition: background .2s;
  }
  .btn-agregar:hover { background: var(--ink2); }

  .rx-actions { display: flex; justify-content: flex-end; gap: .8rem; margin-top: 1.5rem; }
  .btn-cancel {
    padding: 9px 20px; border: 1.5px solid var(--border); border-radius: 10px;
    background: white; color: var(--muted); font-size: .88rem; cursor: pointer;
    font-family: var(--sans); transition: all .2s; text-decoration: none;
    display: inline-flex; align-items: center;
  }
  .btn-cancel:hover { border-color: var(--ink); color: var(--ink); }
  .btn-generar {
    padding: 9px 24px; background: var(--green); color: white; border: none;
    border-radius: 10px; font-size: .88rem; font-weight: 600; cursor: pointer;
    font-family: var(--sans); transition: background .2s;
  }
  .btn-generar:hover { background: var(--green2); }

  .rx-alert-error {
    background: #fee2e2; color: #991b1b; border: 1px solid #fecaca;
    border-radius: var(--r); padding: .8rem 1rem; margin-bottom: 1.2rem; font-size: .88rem;
  }

  @media(max-width:600px) {
    .med-grid-top { grid-template-columns: 1fr; }
  }
</style>

<div class="rx-wrap">

  <div class="rx-page-header">
    <div class="rx-page-icon">📋</div>
    <div>
      <div class="rx-page-title">Emitir Receta Médica</div>
      <div class="rx-page-sub">Puedes recetar uno o varios medicamentos al paciente</div>
    </div>
  </div>

  {{#if error}}
    <div class="rx-alert-error">{{error}}</div>
  {{/if}}

  <form method="POST" action="/recetas">

    {{!-- PACIENTE --}}
    <div class="rx-card">
      <div class="rx-card-head">👤 Paciente</div>
      <div class="rx-card-body">
        <div class="rx-field" style="margin-bottom:0;">
          <label class="rx-label">Correo del paciente *</label>
          <select name="paciente_email" class="rx-select" required>
            <option value="">— Selecciona un paciente —</option>
            {{#each pacientes}}
              <option value="{{email}}"
                {{#ifCond email '===' ../datos.paciente_email}}selected{{/ifCond}}>
                {{email}}{{#if name}} — {{name}}{{/if}}
              </option>
            {{/each}}
          </select>
          <div class="rx-hint">Solo aparecen pacientes registrados en el sistema</div>
        </div>
      </div>
    </div>

    {{!-- MEDICAMENTOS --}}
    <div class="rx-card">
      <div class="rx-card-head">
        💊 Medicamentos
        <button type="button" class="btn-agregar" id="btnAgregar">+ Agregar medicamento</button>
      </div>
      <div class="rx-card-body" id="listaMeds">

        {{!-- Fila plantilla (medicamento 1) --}}
        <div class="med-fila" id="med-0">
          <div class="med-fila-head">
            <span class="med-badge">Medicamento <span class="num">1</span></span>
            <button type="button" class="med-quitar" style="display:none;">✕ Quitar</button>
          </div>
          <div class="med-grid med-grid-top">
            <div class="rx-field" style="margin:0;">
              <label class="rx-label">Del catálogo *</label>
              <select name="medicina_id[]" class="rx-select" required>
                <option value="">— Selecciona —</option>
                {{#each medicinas}}
                  <option value="{{id}}">{{nombre}} ({{presentacion}}){{#if receta}} 🔒{{/if}}</option>
                {{/each}}
              </select>
              <div class="rx-hint">🔒 = Requiere receta</div>
            </div>
            <div class="rx-field" style="margin:0;">
              <label class="rx-label">Dosis</label>
              <input type="text" name="dosis[]" class="rx-input" placeholder="Ej: 1 tableta, 500mg…">
            </div>
          </div>
          <div class="med-grid med-grid-bot" style="margin-top:.8rem;">
            <div class="rx-field" style="margin:0;">
              <label class="rx-label">Indicaciones</label>
              <textarea name="indicaciones[]" class="rx-textarea"
                placeholder="Ej: Tomar cada 8 horas con alimentos por 7 días…"></textarea>
            </div>
          </div>
        </div>

      </div>
    </div>

    <div class="rx-actions">
      <a href="/doctors/panel/dashboard" class="btn-cancel">Cancelar</a>
      <button type="submit" class="btn-generar">📄 Generar Receta</button>
    </div>

  </form>
</div>

<script>
(function () {
  const lista    = document.getElementById('listaMeds');
  const plantilla = document.getElementById('med-0');
  // Lista de medicinas para clonar el select
  const medicinasJSON = {{{json medicinas}}};

  function buildSelect(name) {
    const sel = document.createElement('select');
    sel.name = name;
    sel.className = 'rx-select';
    sel.required = true;
    const def = document.createElement('option');
    def.value = '';
    def.textContent = '— Selecciona —';
    sel.appendChild(def);
    medicinasJSON.forEach(m => {
      const opt = document.createElement('option');
      opt.value = m.id;
      opt.textContent = m.nombre + ' (' + m.presentacion + ')' + (m.receta ? ' 🔒' : '');
      sel.appendChild(opt);
    });
    return sel;
  }

  function actualizarBotones() {
    const filas = lista.querySelectorAll('.med-fila');
    filas.forEach(f => {
      f.querySelector('.med-quitar').style.display = filas.length > 1 ? '' : 'none';
    });
    // Renumerar
    filas.forEach((f, i) => f.querySelector('.num').textContent = i + 1);
  }

  document.getElementById('btnAgregar').addEventListener('click', () => {
    const fila = document.createElement('div');
    fila.className = 'med-fila';
    fila.innerHTML = `
      <div class="med-fila-head">
        <span class="med-badge">Medicamento <span class="num"></span></span>
        <button type="button" class="med-quitar">✕ Quitar</button>
      </div>
      <div class="med-grid med-grid-top">
        <div class="rx-field" style="margin:0;">
          <label class="rx-label">Del catálogo *</label>
          <div class="select-wrap"></div>
          <div class="rx-hint">🔒 = Requiere receta</div>
        </div>
        <div class="rx-field" style="margin:0;">
          <label class="rx-label">Dosis</label>
          <input type="text" name="dosis[]" class="rx-input" placeholder="Ej: 1 tableta, 500mg…">
        </div>
      </div>
      <div class="med-grid med-grid-bot" style="margin-top:.8rem;">
        <div class="rx-field" style="margin:0;">
          <label class="rx-label">Indicaciones</label>
          <textarea name="indicaciones[]" class="rx-textarea"
            placeholder="Ej: Tomar cada 8 horas con alimentos por 7 días…"></textarea>
        </div>
      </div>`;

    fila.querySelector('.select-wrap').appendChild(buildSelect('medicina_id[]'));
    fila.querySelector('.med-quitar').addEventListener('click', () => {
      fila.remove();
      actualizarBotones();
    });
    lista.appendChild(fila);
    actualizarBotones();
  });

  // Botón quitar de la fila inicial
  plantilla.querySelector('.med-quitar').addEventListener('click', () => {
    plantilla.remove();
    actualizarBotones();
  });
})();
</script>
