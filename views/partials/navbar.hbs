<nav class="navbar">
  <div class="container nav-inner">
    <a href="/" class="logo">
      <svg width="32" height="32" viewBox="0 0 28 28" fill="none">
        <rect width="28" height="28" rx="8" fill="#0A5C8C"/>
        <path d="M14 7v14M7 14h14" stroke="white" stroke-width="2.5" stroke-linecap="round"/>
      </svg>
      <span class="logo-text">Enfermeria Unipoli</span>
    </a>
    <div class="nav-links" id="navLinks">
      <a href="/doctors/search">Buscar Medicos</a>
      <a href="/medicinas">Medicinas</a>
