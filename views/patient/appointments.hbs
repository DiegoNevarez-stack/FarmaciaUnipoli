<style>
.ma-hero { background: var(--ink); padding: 2.5rem 0 5rem; position: relative; overflow: hidden; }
.ma-hero-wave { position: absolute; bottom: -1px; left: 0; right: 0; height: 50px; background: var(--bg); clip-path: ellipse(55% 100% at 50% 100%); }
.ma-hero-title { font-family: var(--serif); font-size: 2rem; color: white; margin-bottom: .4rem; }
.ma-hero-sub { color: rgba(255,255,255,0.4); font-size: .9rem; }

.ma-wrap { max-width: 860px; margin: -2rem auto 4rem; padding: 0 2rem; position: relative; }

.ma-tabs { display: flex; gap: .4rem; background: white; border: 1px solid var(--border); border-radius: 14px; padding: .4rem; margin-bottom: 1.5rem; }
.ma-tab { flex: 1; padding: 9px; border: none; background: transparent; border-radius: 10px; font-size: .85rem; font-weight: 500; cursor: pointer; color: var(--muted2); transition: all .18s; font-family: var(--sans); }
.ma-tab.on { background: var(--ink); color: white; }

.ma-card { background: white; border: 1px solid var(--border); border-radius: 18px; overflow: hidden; margin-bottom: .9rem; display: flex; transition: all .2s; }
.ma-card:hover { box-shadow: 0 6px 24px rgba(0,0,0,0.07); }
.ma-date { background: var(--ink); color: white; padding: 1.4rem 1.2rem; display: flex; flex-direction: column; align-items: center; justify-content: center; min-width: 80px; text-align: center; }
.ma-day { font-family: var(--serif); font-size: 2rem; line-height: 1; }
.ma-month { font-size: .65rem; text-transform: uppercase; letter-spacing: .1em; opacity: .4; margin-top: 2px; }
.ma-time { font-size: .75rem; font-weight: 500; background: rgba(255,255,255,0.1); border-radius: 20px; padding: 3px 8px; margin-top: 6px; }
.ma-body { padding: 1.3rem 1.5rem; flex: 1; display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
.ma-info { flex: 1; }
.ma-doctor { font-family: var(--serif); font-size: 1.05rem; margin-bottom: .2rem; }
.ma-reason { font-size: .83rem; color: var(--muted2); }
.ma-actions { display: flex; flex-direction: column; align-items: flex-end; gap: .5rem; }
.ma-status { padding: 4px 12px; border-radius: 50px; font-size: .75rem; font-weight: 600; }
.st-pending { background: #FFF8EE; color: #B45309; border: 1px solid #FDE68A; }
.st-confirmed { background: #F0FAF8; color: #047857; border: 1px solid rgba(0,198,160,0.25); }
.st-cancelled { background: #FEF2F2; color: #991B1B; border: 1px solid #FECACA; }
.st-completed { background: #F0F9FF; color: #0369A1; border: 1px solid #BAE6FD; }
.ma-cancel-btn { padding: 5px 12px; border: 1.5px solid var(--border); border-radius: 8px; background: white; color: var(--muted); font-size: .78rem; font-weight: 500; cursor: pointer; transition: all .18s; font-family: var(--sans); }
.ma-cancel-btn:hover { border-color: #FECACA; color: #991B1B; }

.ma-empty { text-align: center; padding: 4.5rem 2rem; background: white; border-radius: 18px; border: 1px solid var(--border); }
.ma-empty-icon { font-size: 3rem; margin-bottom: 1rem; opacity: .4; }
.ma-empty h3 { font-family: var(--serif); font-size: 1.4rem; margin-bottom: .4rem; }
.ma-empty p { color: var(--muted2); font-size: .88rem; margin-bottom: 1.5rem; }
.ma-empty-btn { display: inline-block; padding: 11px 28px; background: var(--ink); color: white; border-radius: 10px; font-size: .9rem; font-weight: 500; transition: background .2s; }
.ma-empty-btn:hover { background: var(--ink2); }

.ma-new-btn { display: inline-block; padding: 11px 28px; background: var(--ink); color: white; border-radius: 10px; font-size: .88rem; font-weight: 500; margin-top: 1.2rem; transition: background .2s; }
.ma-new-btn:hover { background: var(--ink2); }
</style>

<div class="ma-hero">
  <div class="ma-hero-wave"></div>
  <div class="container">
    <div class="ma-hero-title">Mis citas</div>
    <div class="ma-hero-sub">Gestiona todas tus consultas médicas</div>
  </div>
</div>

<div class="ma-wrap">
  <div class="ma-tabs">
    <button class="ma-tab on" onclick="filter('all',this)">Todas ({{appointments.length}})</button>
    <button class="ma-tab" onclick="filter('pending',this)">Pendientes</button>
    <button class="ma-tab" onclick="filter('confirmed',this)">Confirmadas</button>
    <button class="ma-tab" onclick="filter('cancelled',this)">Canceladas</button>
  </div>

  {{#if appointments.length}}
    <div id="list">
      {{#each appointments}}
        <div class="ma-card" data-status="{{status}}">
          <div class="ma-date">
            <div class="ma-day">{{dayNumber date}}</div>
            <div class="ma-month">{{monthShort date}}</div>
            <div class="ma-time">{{time}}</div>
          </div>
          <div class="ma-body">
            <div class="ma-info">
              <div class="ma-doctor">{{doctorName}}</div>
              {{#if reason}}<div class="ma-reason">{{truncate reason 60}}</div>{{/if}}
            </div>
            <div class="ma-actions">
              <span class="ma-status st-{{status}}">{{statusLabel status}}</span>
              {{#ifCond status '!==' 'cancelled'}}
                {{#ifCond status '!==' 'completed'}}
                  <button class="ma-cancel-btn" onclick="cancelAppt('{{id}}')">Cancelar</button>
                {{/ifCond}}
              {{/ifCond}}
            </div>
          </div>
        </div>
      {{/each}}
    </div>
    <a href="/doctors/search" class="ma-new-btn">+ Agendar nueva cita</a>
  {{else}}
    <div class="ma-empty">
      <div class="ma-empty-icon">🗓</div>
      <h3>Sin citas agendadas</h3>
      <p>Busca un especialista y reserva tu primera consulta</p>
      <a href="/doctors/search" class="ma-empty-btn">Buscar médico</a>
    </div>
  {{/if}}
</div>

<script>
function filter(s, btn) {
  document.querySelectorAll('.ma-tab').forEach(t => t.classList.remove('on'));
  btn.classList.add('on');
  document.querySelectorAll('.ma-card').forEach(c => {
    c.style.display = (s === 'all' || c.dataset.status === s) ? 'flex' : 'none';
  });
}
async function cancelAppt(id) {
  if (!confirm('¿Cancelar esta cita?')) return;
  const r = await fetch(`/appointments/${id}`, { method: 'DELETE' });
  const d = await r.json();
  if (d.success) location.reload(); else alert('Error al cancelar');
}
</script>
