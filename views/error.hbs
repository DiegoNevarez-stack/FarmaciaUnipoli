<style>
.err-wrap { min-height: calc(100vh - 64px); display: flex; align-items: center; justify-content: center; padding: 3rem 2rem; }
.err-box { text-align: center; max-width: 420px; }
.err-code { font-family: var(--serif); font-size: 7rem; color: var(--border); line-height: 1; margin-bottom: 1rem; }
.err-title { font-family: var(--serif); font-size: 1.6rem; margin-bottom: .5rem; }
.err-msg { color: var(--muted2); font-size: .9rem; margin-bottom: 2rem; line-height: 1.6; }
.err-btn { display: inline-block; padding: 12px 28px; background: var(--ink); color: white; border-radius: 10px; font-size: .9rem; font-weight: 500; transition: background .2s; }
.err-btn:hover { background: var(--ink2); }
</style>
<div class="err-wrap">
  <div class="err-box">
    <div class="err-code">!</div>
    <h1 class="err-title">Algo salió mal</h1>
    <p class="err-msg">{{message}}</p>
    <a href="/" class="err-btn">Volver al inicio</a>
  </div>
</div>
